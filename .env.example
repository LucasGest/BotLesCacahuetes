DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optionnel : salon Discord où les erreurs du bot sont loggées (en plus de la console).
LOG_CHANNEL_ID=

# Optionnel : IDs des rôles staff, séparés par des virgules. Utilisé par les futures
# commandes/boutons réservés au staff (tickets, candidatures...).
STAFF_ROLE_IDS=

# Optionnel : identifiants Firebase (Firestore) pour les données qui doivent
# survivre aux redéploiements (ex: anniversaires). Sans ça, ces fonctionnalités
# restent désactivées mais le reste du bot marche normalement.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optionnel : clé API HenrikDev (https://docs.henrikdev.xyz/) pour /lier-riot.
# Sans ça, la commande répond juste qu'elle n'est pas configurée.
HENRIKDEV_API_KEY=

# Optionnel : identifiants de l'app Twitch (https://dev.twitch.tv/console/apps)
# pour les annonces de live automatiques. Sans ça, cette fonctionnalité reste
# désactivée mais le reste du bot marche normalement.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
